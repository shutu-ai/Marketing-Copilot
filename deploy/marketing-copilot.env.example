DUCKDB_PATH=/var/lib/marketing-copilot/marketing_copilot.duckdb
MC_FRONTEND_DIR=/opt/marketing-copilot/frontend/dist
MC_LOG_PATH=/var/log/marketing-copilot/app.log
MC_INSTANCE_LOCK=/run/marketing-copilot/instance.lock
MC_BACKUP_DIR=/var/lib/marketing-copilot/backups
MC_BACKUP_KEEP=14
MC_MAX_UPLOAD_BYTES=104857600
MC_SYSTEM_MODE=production
MC_TASK_WORKERS=4
MC_ALERT_QUEUE_DEPTH=1000
MC_ALERT_FAILURE_RATE=0.20
MC_ALERT_WEBHOOK_URL=
MC_ALERT_WEBHOOK_TIMEOUT=5
