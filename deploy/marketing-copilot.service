[Unit]
Description=Marketing Copilot
After=network.target

[Service]
Type=simple
User=marketing-copilot
WorkingDirectory=/opt/marketing-copilot/backend
EnvironmentFile=/etc/marketing-copilot.env
Environment=PYTHONUNBUFFERED=1
StateDirectory=marketing-copilot
LogsDirectory=marketing-copilot
RuntimeDirectory=marketing-copilot
ExecStart=/opt/marketing-copilot/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
# Only the main process is signalled on stop so the detached update runner
# (spawned by the web process) can survive `systemctl stop` and finish the
# directory swap before starting the new version.
KillMode=process
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
