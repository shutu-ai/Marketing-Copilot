# Canonical control-plane store. It must be created by the stopped-service
# cutover tool before the first production start; the old database is only an
# offline migration input and is never opened by the running service.
MC_CONTROL_DB_PATH=$APP_HOME/data/control/vnext-control.duckdb
DUCKDB_PATH=$APP_HOME/data/control/vnext-control.duckdb
MC_REQUIRE_CANONICAL_STORE=1
MC_DUCKDB_EXTENSION_DIR=$APP_HOME/offline/extensions
# Standalone SLES12SP5 runtime; installed outside the online-update trees.
MC_PYTHON_BIN=/opt/marketing-copilot/python/bin/python3.11
MC_FRONTEND_DIR=$APP_HOME/frontend/dist
MC_HOST=0.0.0.0
MC_PORT=19090
MC_LOG_PATH=$APP_HOME/logs/app.log
MC_LOG_LEVEL=INFO
MC_DETAIL_LOGGING=0
MC_INSTANCE_LOCK=$APP_HOME/run/instance.lock
MC_BACKUP_DIR=$APP_HOME/backups
MC_BACKUP_KEEP=14
MC_REALTIME_FILE_RETENTION_DAYS=1
MC_REALTIME_OUTPUT_RETENTION_DAYS=30
MC_REALTIME_INGEST_WORKERS=4
# Display progress is coalesced per file; chunk checkpoints/terminal states are not throttled.
MC_REALTIME_PROGRESS_INTERVAL_SECONDS=2
MC_REALTIME_WATCH_RESCAN_SECONDS=30
MC_REALTIME_WHITELIST_BUILD_MEMORY_LIMIT=4GB
MC_MAX_UPLOAD_BYTES=2147483648
MC_SYSTEM_MODE=production
MC_TASK_WORKERS=8
MC_CLAIM_BATCH=30
MC_DUCKDB_WRITE_LOCK_TIMEOUT_SECONDS=5
# Short retries for transient DuckDB file/WAL/lock read failures used by Web/API reads.
MC_DUCKDB_READ_RETRIES=2
MC_DUCKDB_READ_RETRY_DELAY_MS=50
MC_SMS_WRITE_BATCH_SIZE=1000
# Maximum number of buffered SMS result events in one DuckDB transaction.
MC_SMS_WRITE_TRANSACTION_SIZE=250
# Rate-limit repeated transient DuckDB lock warnings; events remain durable/retryable.
MC_SMS_WRITE_TRANSIENT_LOG_INTERVAL_SECONDS=60
MC_SMS_WRITE_FLUSH_MS=100
MC_BATCH_RESET_INTERVAL_SECONDS=60
MC_BATCH_CANCEL_INTERVAL_SECONDS=30
# Bounded overdue cleanup per run: four campaigns and 250 tasks per campaign.
MC_BATCH_CANCEL_BATCH_SIZE=250
MC_BATCH_CANCEL_CAMPAIGNS_PER_RUN=4
MC_SMS_RESULT_JOURNAL_FSYNC_MS=2
MC_SMS_RESULT_JOURNAL_FSYNC_BATCH=250
MC_SMS_RESULT_JOURNAL_QUEUE_CAPACITY=100000
MC_SMS_RESULT_JOURNAL_COMPACT_BYTES=268435456
MC_SMS_RESULT_JOURNAL_COMPACT_INTERVAL_SECONDS=300
MC_FAIR_TASK_SCHEDULER_ENABLED=1
MC_FAIR_ACTIVE_CAMPAIGNS=128
MC_FAIR_CLAIM_PER_CAMPAIGN=30
MC_FAIR_DRR_QUANTUM_PARTS=20
MC_FAIR_CLAIM_TOTAL=0
# Projection recovery is isolated from the send path.  The owner lock is
# acquired only when the projection child starts; repeated native failures
# enter a cooldown instead of creating a restart/lock storm.
MC_VNEXT_PROJECTION_LOCK_WAIT_SECONDS=30
MC_VNEXT_PROJECTION_RESTART_MAX_FAILURES=5
MC_VNEXT_PROJECTION_RESTART_COOLDOWN_SECONDS=60
MC_VNEXT_PROJECTION_RESTART_MAX_BACKOFF_SECONDS=30
MC_SMS_WRITE_QUEUE_CAPACITY=100000
MC_TASK_CLEANUP_BATCH=5000
MC_TASK_ARCHIVE_ENABLED=true
MC_TASK_ARCHIVE_DIR=
MC_INGEST_CHUNK_LEASE_SECONDS=300
MC_CHUNK_HIGH_WATERMARK=100000
MC_CHUNK_LOW_WATERMARK=50000
MC_WRITE_QUEUE_HIGH_WATERMARK=80000
MC_WRITE_QUEUE_LOW_WATERMARK=30000
MC_DISK_HIGH_WATERMARK_PCT=95
MC_DISK_LOW_WATERMARK_PCT=90
MC_DISK_MIN_FREE_GB=1
MC_SMPP_WINDOW_SIZE=10
MC_SMPP_INTERNAL_TPS_MULTIPLIER=1
# Per-SMPP-connection asynchronous send queue; leave unset to use window_size*4.
MC_SMPP_SEND_QUEUE_CAPACITY=
MC_ALERT_QUEUE_DEPTH=1000
MC_ALERT_FAILURE_RATE=0.20
MC_ALERT_WEBHOOK_URL=
MC_ALERT_WEBHOOK_TIMEOUT=5

# --- 管理认证（在线更新的前置条件） ---
# MC_AUTH_DISABLED=1 会完全关闭登录校验，仅建议开发/自动化测试使用。
MC_AUTH_DISABLED=0
MC_ADMIN_USERNAME=admin
# 首次启动播种的初始管理员；之后在「系统设置」→「用户与权限」中管理用户/角色/密码。
# 默认密码：生产环境部署后必须修改。
MC_ADMIN_PASSWORD=Huawei@123
# 留空时自动生成并持久化到 $MC_STATE_DIR/auth_secret；
# 设置固定值可保证重启后已签发令牌不失效。
MC_AUTH_SECRET=
MC_AUTH_TOKEN_TTL_HOURS=12

# --- 在线更新 ---
# systemd 托管部署使用 systemd 模式；手动/nohup 部署使用 manual 模式。
MC_UPDATE_MODE=systemd
MC_STATE_DIR=$APP_HOME/data
MC_UPDATE_DIR=$APP_HOME/updates
MC_PIPELINE_MODE=vnext
MC_VNEXT_RUN_ROOT=$APP_HOME/data/vnext
MC_VNEXT_WORKERS=4
MC_VNEXT_PARTITIONS=256
# Retain the current day plus the seven-day historical window. Aging runs in
# the projection owner in bounded batches and never scans the startup path.
MC_VNEXT_RETENTION_DAYS=7
MC_VNEXT_RETENTION_BATCH=5000
MC_VNEXT_RETENTION_INTERVAL_SECONDS=60
# Hard spool budget.  Minimum production default is 4 GiB; 16 GiB/32 GiB are valid.
MC_VNEXT_MAX_SPOOL_BYTES=4294967296
MC_UPDATE_MAX_TOTAL_BYTES=2147483648
MC_UPDATE_MAX_CHUNK_BYTES=67108864
MC_UPDATE_HEALTH_TRIES=180
MC_UPDATE_HEALTH_INTERVAL=2
MC_UPDATE_KEEP_BACKUPS=3
MC_UPDATE_KEEP_UPLOADS=3
