// Allow the marketing-copilot service account to start/stop/restart its own
// systemd unit. Required for the web self-update flow: the detached update
// runner stops and starts the service between the directory swap.
polkit.addRule(function (action, subject) {
  if (
    action.id === "org.freedesktop.systemd1.manage-units" &&
    action.lookup("unit") === "marketing-copilot.service" &&
    subject.user === "marketing-copilot"
  ) {
    return polkit.Result.YES;
  }
});
