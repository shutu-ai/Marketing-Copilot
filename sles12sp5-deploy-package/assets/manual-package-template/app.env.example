# DuckDB file location. The UI-saved db_config.json takes precedence after first startup.
DUCKDB_PATH=${APP_HOME}/data/marketing_copilot.duckdb
MC_FRONTEND_DIR=${APP_HOME}/frontend/dist
MC_HOST=0.0.0.0
MC_PORT=19090
MC_LOG_PATH=${APP_HOME}/logs/app.log
MC_LOG_LEVEL=INFO
MC_DETAIL_LOGGING=0
MC_INSTANCE_LOCK=${APP_HOME}/run/instance.lock
MC_BACKUP_DIR=${APP_HOME}/backups
MC_BACKUP_KEEP=14
MC_REALTIME_FILE_RETENTION_DAYS=1
MC_REALTIME_OUTPUT_RETENTION_DAYS=30
MC_REALTIME_INGEST_WORKERS=4
MC_REALTIME_WATCH_RESCAN_SECONDS=30
MC_MAX_UPLOAD_BYTES=2147483648
MC_SYSTEM_MODE=production
MC_TASK_WORKERS=8
MC_CLAIM_BATCH=30
MC_DUCKDB_WRITE_LOCK_TIMEOUT_SECONDS=5
MC_SMS_WRITE_BATCH_SIZE=1000
MC_SMS_WRITE_FLUSH_MS=100
MC_SMS_WRITE_QUEUE_CAPACITY=100000
MC_TASK_CLEANUP_BATCH=5000
MC_TASK_ARCHIVE_ENABLED=true
MC_TASK_ARCHIVE_DIR=
MC_INGEST_CHUNK_LEASE_SECONDS=300
MC_CHUNK_HIGH_WATERMARK=100000
MC_CHUNK_LOW_WATERMARK=50000
MC_WRITE_QUEUE_HIGH_WATERMARK=80000
MC_WRITE_QUEUE_LOW_WATERMARK=30000
MC_DISK_HIGH_WATERMARK_PCT=95
MC_DISK_LOW_WATERMARK_PCT=90
MC_DISK_MIN_FREE_GB=1
MC_SMPP_WINDOW_SIZE=10
MC_SMPP_INTERNAL_TPS_MULTIPLIER=1
MC_ALERT_QUEUE_DEPTH=1000
MC_ALERT_FAILURE_RATE=0.20
MC_ALERT_WEBHOOK_URL=
MC_ALERT_WEBHOOK_TIMEOUT=5

# Authentication. Change the initial production password after deployment.
MC_AUTH_DISABLED=0
MC_ADMIN_USERNAME=admin
MC_ADMIN_PASSWORD=Huawei@123
MC_AUTH_SECRET=
MC_AUTH_TOKEN_TTL_HOURS=12

# Manual/nohup deployments use manual update mode.
MC_UPDATE_MODE=manual
MC_STATE_DIR=${APP_HOME}/data
MC_UPDATE_DIR=${APP_HOME}/updates
MC_UPDATE_MAX_TOTAL_BYTES=2147483648
MC_UPDATE_MAX_CHUNK_BYTES=67108864
MC_UPDATE_HEALTH_TRIES=180
MC_UPDATE_HEALTH_INTERVAL=2
MC_UPDATE_KEEP_BACKUPS=3
MC_UPDATE_KEEP_UPLOADS=3
